timestamp=2026-08-12T11:08:47.816Z level=INFO run=15980255 message=evaluated permission=bash pattern="cat > /home/eternity/Work/docs/ratatui-widget-zh/index.html << 'HTMLEOF'\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Ratatui 自定义组件 Widget 完全指南</title>\n<style>\n</style>\n</head>\n<body>\n<div id=\"app\">\n<aside class=\"sidebar\" id=\"sidebar\">\n  <div class=\"sidebar-header\">\n    <h1>🦀 Ratatui</h1>\n    <p class=\"subtitle\">自定义组件完全指南</p>\n  </div>\n  <nav class=\"sidebar-nav\">\n    <div class=\"nav-section\">\n      <div class=\"nav-section-title\">基础篇</div>\n      <a href=\"#intro\" data-section=\"intro\">概述</a>\n      <a href=\"#widget-basic\" data-section=\"widget-basic\">Widget 与 StatefulWidget</a>\n      <a href=\"#layout\" data-section=\"layout\">布局系统</a>\n      <a href=\"#frame-buffer\" data-section=\"frame-buffer\">Frame 与 Buffer</a>\n    </div>\n    <div class=\"nav-section\">\n      <div class=\"nav-section-title\">绘图篇</div>\n      <a href=\"#canvas\" data-section=\"canvas\">Canvas 画布</a>\n      <a href=\"#shape\" data-section=\"shape\">自定义 Shape</a>\n      <a href=\"#marker\" data-section=\"marker\">标记渲染器</a>\n    </div>\n    <div class=\"nav-section\">\n      <div class=\"nav-section-title\">进阶篇</div>\n      <a href=\"#animation\" data-section=\"animation\">动画与帧率</a>\n      <a href=\"#event\" data-section=\"event\">事件处理</a>\n      <a href=\"#composition\" data-section=\"composition\">组件组合模式</a>\n    </div>\n    <div class=\"nav-section\">\n      <div class=\"nav-section-title\">算法可视化</div>\n      <a href=\"#algo-sort\" data-section=\"algo-sort\">排序算法可视化</a>\n      <a href=\"#algo-fractal\" data-section=\"algo-fractal\">分形图形</a>\n      <a href=\"#algo-particle\" data-section=\"algo-particle\">粒子系统</a>\n      <a href=\"#algo-path\" data-section=\"algo-path\">路径寻迹算法</a>\n    </div>\n    <div class=\"nav-section\">\n      <div class=\"nav-section-title\">综合实战</div>\n      <a href=\"#demo-sine\" data-section=\"demo-sine\">正弦波可视化</a>\n      <a href=\"#demo-radar\" data-section=\"demo-radar\">雷达扫描系统</a>\n    </div>\n  </nav>\n</aside>\n<main class=\"content\" id=\"content\">\nCONTENT_PLACEHOLDER\n</main>\n<div class=\"scroll-top\" id=\"scrollTop\">↑</div>\n</div>\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  var content = document.getElementById('content');\n  var nav = document.querySelectorAll('.sidebar-nav a');\n  var scrollTop = document.getElementById('scrollTop');\n\n  document.querySelectorAll('pre').forEach(function(pre) {\n    var btn = document.createElement('button');\n    btn.className = 'copy-btn';\n    btn.textContent = '复制';\n    btn.addEventListener('click', function() {\n      var code = pre.querySelector('code');\n      navigator.clipboard.writeText(code ? code.textContent : pre.textContent);\n      btn.textContent = '已复制!';\n      setTimeout(function() { btn.textContent = '复制'; }, 1500);\n    });\n    pre.appendChild(btn);\n  });\n\n  content.addEventListener('scroll', function() {\n    var top = content.scrollTop;\n    if (top > 400) { scrollTop.classList.add('visible'); }\n    else { scrollTop.classList.remove('visible'); }\n    updateActiveNav();\n  });\n\n  function updateActiveNav() {\n    var sections = document.querySelectorAll('section[id]');\n    var current = '';\n    sections.forEach(function(sec) {\n      if (sec.offsetTop - content.scrollTop - 80 < 0) { current = sec.id; }\n    });\n    nav.forEach(function(a) {\n      a.classList.toggle('active', a.getAttribute('data-section') === current);\n    });\n  }\n\n  scrollTop.addEventListener('click', function() {\n    content.scrollTo({top: 0, behavior: 'smooth'});\n  });\n});\n</script>\n</body>\n</html>\nHTMLEOF" action.permission=* action.action=allow action.pattern=*
